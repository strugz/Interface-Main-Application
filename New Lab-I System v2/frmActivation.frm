Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit
Dim mPass As New clsBlowfish
Dim mPass2 As New clsBlowfish

Private Sub saveData(mformatteddate As String)
Dim totaldays As String
    SaveSetting "LAB-i", "Program", "Settings", mPass.EncryptString(mformatteddate, myKey, True)
    SaveSetting "LAB-i", "Program", "Install", mPass.EncryptString(Format(Now, "mm/dd/yyyy"), myKey, True)
    SaveSetting "LAB-i", "Program", "Path", mPass.EncryptString("0", myKey, True)
End Sub

Private Sub cmdClose_Click()
    Unload Me
End Sub

Private Sub cmdEnter_Click()
Dim tempStr As String
Dim tempstr1 As String
Dim ctr As Integer
For ctr = 0 To 11
    tempStr = tempStr + txtSerial(ctr).Text
Next ctr
If Len(Trim(tempStr)) > 0 Then
    tempstr1 = mPass.DecryptString(tempStr, myKey, True)
    If IsDate(tempstr1) Then
        saveData Format(tempstr1, "mm/dd/yyyy")
        MsgBox "Program Activated. Please Run the Lab-I Interface System.", vbInformation, App.ProductName
        Unload Me
    Else
        MsgBox "Invalid Activation Code", vbOKOnly + vbInformation, App.ProductName
        txtSerial(0).SetFocus
    End If
Else
    MsgBox "Invalid Activation Code", vbOKOnly + vbInformation, App.ProductName
    txtSerial(0).SetFocus
End If
End Sub

Private Sub Form_Load()
Dim ctr As Integer
For ctr = 0 To 11
    txtSerial(ctr).Text = ""
Next ctr
End Sub

Private Sub lblHeader_Click(Index As Integer)

End Sub

Private Sub txtSerial_Change(Index As Integer)
setFormColors Me
If Len(Trim(txtSerial(Index).Text)) = 4 Then keybd_event VK_TAB, 0, 0, 0
End Sub

Private Sub txtSerial_GotFocus(Index As Integer)
    Highlight
End Sub

Private Sub txtSerial_KeyDown(Index As Integer, KeyCode As Integer, Shift As Integer)
If KeyCode = vbKeyReturn Then keybd_event VK_TAB, 0, 0, 0
End Sub

Private Sub txtSerial_KeyPress(Index As Integer, KeyAscii As Integer)
    KeyAscii = Asc(UCase(Chr(KeyAscii)))
End Sub

