# VB6 only reads CRLF, ANSI source files
*.frm text eol=crlf
*.bas text eol=crlf
*.cls text eol=crlf
*.CLS text eol=crlf
*.ctl text eol=crlf
*.vbp text eol=crlf
*.vbg text eol=crlf

# Binary companions: never touch line endings
*.frx binary
*.ctx binary
*.res binary
*.RES binary
*.rpt binary
*.RPT binary
*.sys binary
*.jpg binary
*.ico binary
*.xlsx binary
